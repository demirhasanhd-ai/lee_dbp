{
  "name": "lee_dbp",
  "version": "1.1.9",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/start-local-dbp.mjs",
    "dev:vinext": "vinext dev",
    "start:local": "node scripts/start-local-dbp.mjs",
    "build": "vinext build && node scripts/export_course_packages_seed.mjs",
    "start": "node server.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dbp:generate-data": "python scripts/generate_course_data.py",
    "dbp:validate": "python scripts/validate_course_data.py",
    "dbp:generate-pdfs": "python scripts/generate_public_course_pdfs.py",
    "dbp:refresh": "npm run dbp:generate-data && npm run dbp:validate && npm run dbp:generate-pdfs",
    "dbp:import": "python scripts/import_curriculum_excel.py"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "0.0.50"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
